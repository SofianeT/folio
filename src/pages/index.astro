---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import Grid from "../components/Grid.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import Skills from "../components/Skills.astro";

const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title="Sofiane Tigrine – Développeur full stack"
  description="Développeur full stack spécialisé en React, Node.js et applications web métier."
>
  <div class="stack gap-24 lg:gap-48">
    <!-- HERO -->
    <div class="wrapper stack gap-12 lg:gap-20">
      <header class="hero">
        <Hero
          title="Développeur full stack"
          tagline="Je conçois et développe des applications web performantes, maintenables et orientées métier."
          align="start"
        />

        <img
          alt="Portrait de Sofiane Tigrine"
          width="480"
          height="620"
          src="/assets/portrait.jpeg"
        />
      </header>

      <Skills />
    </div>

    <!-- PROJETS -->
    <main class="wrapper">
      <section class="projects-section">
        <header class="projects-header">
          <div>
            <h3>Projets sélectionnés</h3>
            <p>
              Applications web et logicielles développées dans des contextes
              professionnels et institutionnels.
            </p>
          </div>

          <a href="/work/" class="btn ghost">
            Voir tous les projets
            <Icon icon="arrow-right" size="1.1em" />
          </a>
        </header>

        <Grid variant="offset">
          {
            projects.map((project) => (
              <li>
                <PortfolioPreview project={project} />
              </li>
            ))
          }
        </Grid>
      </section>
    </main>

    <!-- CTA FINAL -->
    <section class="cta-final">
      <h2>Échanger sur votre projet</h2>
      <p>
        Besoin d’un développeur pour renforcer une équipe ou concevoir une
        application web ? Planifions un échange.
      </p>

      <a
        href="https://calendly.com/sofiane-tigrine15/30min"
        target="_blank"
        rel="noopener"
        class="btn primary large"
      >
        Prendre rendez-vous
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  /* ================= HERO ================= */

  .hero {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 50em) {
    .hero {
      grid-template-columns: 6fr 4fr;
      align-items: center;
    }
  }

  .hero img {
    border-radius: 3rem;
    object-fit: cover;
    box-shadow: var(--shadow-lg);
  }

  /* ================= PROJETS ================= */

  .projects-section {
    display: grid;
    gap: 4rem;
  }

  .projects-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }

  .projects-header h3 {
    font-size: var(--text-3xl);
  }

  .projects-header p {
    max-width: 50ch;
    color: var(--gray-300);
    margin-top: 0.5rem;
  }

  /* ================= CTA FINAL ================= */

  .cta-final {
    text-align: center;
    padding: 6rem 1rem;
    background: radial-gradient(
      600px at 50% 100%,
      rgba(124, 58, 237, 0.15),
      transparent 70%
    );
  }

  .cta-final h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .cta-final p {
    max-width: 55ch;
    margin: 1.5rem auto 3rem;
    color: var(--gray-300);
  }

  /* ================= BOUTONS ================= */

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.4rem;
    border-radius: 999px;
    font-weight: 500;
    transition: all 0.25s ease;
  }

  .btn.primary {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    color: white;
    box-shadow: 0 10px 30px rgba(124, 58, 237, 0.35);
  }

  .btn.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(124, 58, 237, 0.45);
  }

  .btn.large {
    font-size: 1.05rem;
    padding: 1.1rem 1.8rem;
  }

  .btn.ghost {
    color: var(--accent);
    border: 1px solid var(--gray-700);
    background: rgba(15, 120, 201, 0.953);
  }

  .btn.ghost:hover {
    background: rgba(124, 58, 237, 0.1);
    border-color: var(--accent);
  }
</style>

---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import Grid from "../components/Grid.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import Skills from "../components/Skills.astro";

const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title="Sofiane Tigrine – Développeur full stack"
  description="Développeur full stack spécialisé en React, Node.js et applications web métier. Projets professionnels et institutionnels."
>
  <div class="page stack gap-20 lg:gap-48">
    <!-- HERO -->
    <section class="wrapper">
      <header class="hero hero-home">
        <div class="hero-content">
          <Hero
            title="Développeur full stack"
            tagline="Je conçois et développe des applications web performantes, maintenables et adaptées aux besoins métier."
            align="start"
          />
        </div>

        <img
          alt="Portrait de Sofiane Tigrine"
          width="480"
          height="620"
          src="/assets/portrait.jpeg"
        />
      </header>

      <Skills />
    </section>

    <!-- PROJETS -->
    <main class="wrapper">
      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Projets sélectionnés</h3>
          <p>
            Applications web et logicielles développées dans des contextes
            professionnels et institutionnels.
          </p>
        </header>

        <div class="gallery">
          <Grid variant="offset">
            {
              projects.map((project) => (
                <li>
                  <PortfolioPreview project={project} />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <a href="/work/" class="btn secondary">
            Voir tous les projets
            <Icon icon="arrow-right" size="1.2em" />
          </a>
        </div>
      </section>
    </main>

    <!-- CTA FINAL -->
    <section class="cta-final">
      <div class="cta-final-content stack gap-4">
        <h2>Échanger sur votre projet</h2>
        <p>
          Besoin d’un développeur pour renforcer une équipe ou concevoir une
          application web ? Planifions un échange.
        </p>
        <a
          href="https://calendly.com/ton-lien"
          target="_blank"
          rel="noopener"
          class="btn primary"
        >
          Prendre rendez-vous
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* =========================
     STRUCTURE GLOBALE
  ========================= */

  .page {
    width: 100%;
  }

  /* =========================
     HERO
  ========================= */

  .hero-home {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hero-content {
    max-width: 55ch;
  }

  .hero-home img {
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: top;
    border-radius: 3rem;
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 50em) {
    .hero-home {
      grid-template-columns: 6fr 4fr;
    }
  }

  /* =========================
     SECTION PROJETS
  ========================= */

  .section {
    display: grid;
    gap: 2.5rem;
    max-width: 1200px;
    margin-inline: auto;
  }

  .section-header {
    max-width: 50ch;
    text-align: center;
    margin-inline: auto;
    color: var(--gray-300);
  }

  .section-header h3 {
    font-size: var(--text-2xl);
  }

  .gallery {
    width: 100%;
  }

  .cta {
    margin-top: 2rem;
    text-align: center;
  }

  @media (min-width: 50em) {
    .section {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas:
        "header header header header"
        "gallery gallery gallery gallery";
      gap: 5rem;
    }

    .section.with-cta {
      grid-template-areas:
        "header header header cta"
        "gallery gallery gallery gallery";
    }

    .section-header {
      grid-area: header;
      text-align: left;
      margin-inline: 0;
    }

    .gallery {
      grid-area: gallery;
    }

    .cta {
      grid-area: cta;
      text-align: right;
      align-self: end;
    }
  }

  /* =========================
     CTA FINAL
  ========================= */

  .cta-final {
    padding: 4rem 1rem;
  }

  .cta-final-content {
    max-width: 48ch;
    margin-inline: auto;
    text-align: center;
  }
</style>

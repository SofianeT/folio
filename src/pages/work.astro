---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";

const projects = (await getCollection("work")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Projets | Sofiane Tigrine – Développeur Full Stack"
  description="Sélection de projets professionnels en développement web et logiciel : applications métiers, plateformes institutionnelles et projets full stack."
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="Projets réalisés"
        tagline="Applications web et logicielles développées dans des contextes professionnels et institutionnels."
        align="start"
      />

      <Grid variant="offset">
        {
          projects.map((project) => (
            <li>
              <PortfolioPreview project={project} />
            </li>
          ))
        }
      </Grid>
    </main>

    <section class="wrapper stack gap-4">
      <h2>Échanger sur votre projet</h2>
      <p>
        Vous avez un besoin technique ou une opportunité à discuter ? Planifions
        un échange.
      </p>
      <a
        href="https://calendly.com/ton-lien"
        target="_blank"
        rel="noopener"
        class="btn primary"
      >
        Prendre rendez-vous
      </a>
    </section>
  </div>
</BaseLayout>
